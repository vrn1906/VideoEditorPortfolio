# Server-only variables. Never prefix secrets with VITE_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
ADMIN_USERNAME=varun
# Run node scripts/hash-password.mjs to create this value.
ADMIN_PASSWORD_HASH=
# Optional here: can also be connected privately from /admin.
YOUTUBE_API_KEY=
INSTAGRAM_ACCESS_TOKEN=
